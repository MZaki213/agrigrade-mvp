# ============================================================
# AgriGrade — Environment Variables Template
# ============================================================
# Salin file ini menjadi .env.local dan isi dengan nilai asli.
# File .env.local TIDAK boleh di-commit ke Git.
# File ini (.env.example) AMAN untuk di-commit — tidak mengandung secret.
# ============================================================

# URL project Supabase kamu.
# Dapatkan dari: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key Supabase (aman untuk diekspos di browser).
# Dapatkan dari: Supabase Dashboard → Project Settings → API → Project API Keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Password untuk halaman admin AgriGrade.
# Hanya tersedia di server (tidak ada prefix NEXT_PUBLIC_).
# Buat password yang kuat — ini satu-satunya perlindungan halaman /admin.
ADMIN_PASSWORD=
